{
    "name": "webetdesign/aceeditor-bundle",
    "type": "symfony-bundle",
    "description": "Bundle that integrate excellent JavaScript ace editor into Symfony Form.",
    "keywords": [
        "ace",
        "code",
        "editor",
        "symfony",
        "form",
        "bundle",
        "javascript"
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "twig/twig": "^1.34|^2.0|^3.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/form": "^7.4",
        "symfony/twig-bridge": "^7.4",
        "symfony/asset": "^7.4",
        "symfony/expression-language": "^7.4"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^9.2"
    },
    "autoload": {
        "psr-4": {
            "Norzechowicz\\AceEditorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Norzechowicz\\AceEditorBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.0-dev"
        }
    },
    "scripts": {
        "build": [
            "@static:analyze",
            "@test"
        ],
        "test": [
            "phpunit"
        ],
        "static:analyze": [
            "php-cs-fixer fix --dry-run"
        ],
        "cs:php:fix": "php-cs-fixer fix"
    }
}
